    {
      "name": "文件上传接口",
      "item": [
        {
          "name": "上传菜品图片 - 手动选择 file",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "const json = pm.response.json();",
                "if (json.data && json.data.url) { pm.collectionVariables.set('imageUrl', json.data.url); }"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
